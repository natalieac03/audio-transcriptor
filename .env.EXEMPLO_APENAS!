# Copie este arquivo para .env:
# cp .env.example .env

# Obrigatório apenas no modo OpenRouter :) se n for usar n precisa colocar isso
OPENROUTER_API_KEY=coloque_sua_chave_aqui



# Alternativas de modelo, só remover o "#" da frente do que vc for usar

# OPENROUTER_STT_MODEL=openai/whisper-large-v3
# OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe (+++ QUALIDADE)
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe (melhor custo-benefício)
# OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo (mais rápido/barato para lote)
# OPENROUTER_STT_MODEL=openai/whisper-1

# Backend padrão: local ou openrouter
TRANSCRIPTION_BACKEND=local

# Idioma padrão: pt, en, es ou auto
TRANSCRIPTION_LANGUAGE=pt

# Configuração do faster-whisper local
LOCAL_WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Configuração OpenRouter
MAX_OPENROUTER_MB=25
OPENROUTER_TIMEOUT=300

# Opcionais
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Transcritor Local de Entrevistas
